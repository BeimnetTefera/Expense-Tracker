# Copy this file to .env (same folder) and fill in real values.
# NEVER put real secrets here: this file is committed to git and is public.
GROQ_API_KEY=your-groq-api-key-here
MAX_STEPS=5

# Relative paths are resolved from the backend/ folder.
DB_PATH=expenses.db
LOG_DIR=logs

# Comma-separated websites allowed to call the API from a browser (CORS).
# Add your deployed frontend URL here (or in the host's dashboard) when you deploy.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
