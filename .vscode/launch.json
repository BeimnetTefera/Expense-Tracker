{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Expense Agent (CLI)",
            "type": "debugpy",
            "request": "launch",
            "module": "app.cli",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "name": "Debug Expense Agent (API)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app.api.main:app", "--reload"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend"
        }
    ]
}
